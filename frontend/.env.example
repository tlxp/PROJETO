# Copie para frontend/.env — nunca versione valores reais.
# Gere valores seguros: scripts/generate-production-secrets.ps1

# URL da API Python (RAT Analyzer)
VITE_API_URL=http://127.0.0.1:8000

# Mesmo valor que RATANALYZER_API_TOKEN no backend (obrigatório se o backend exige token)
# VITE_API_TOKEN=

# Idioma inicial da SPA: pt | en (também propagado pelo WPF ao arrancar npm run dev)
# VITE_DEFAULT_LOCALE=pt

# Layout mock sem backend (só em npm run dev): botão na página de upload
# Alternativa: abrir http://localhost:5173/?demo=1
# VITE_ENABLE_MOCK_DEMO=true
