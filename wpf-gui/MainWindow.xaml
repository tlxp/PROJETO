<Window x:Class="RatAnalyzer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RatAnalyzer.Desktop.Views"
        mc:Ignorable="d"
        Title="Rat Analyzer"
        Icon="/Assets/app-icon.ico"
        Width="1080"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">
    <Border Margin="20"
            CornerRadius="{StaticResource Radius.XLarge}"
            BorderBrush="{StaticResource BorderBrushBase}"
            BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#131316" Offset="0" />
                <GradientStop Color="#0D0D10" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="20">
            <ContentControl x:Name="ContentHost" />
        </Grid>
    </Border>
</Window>
