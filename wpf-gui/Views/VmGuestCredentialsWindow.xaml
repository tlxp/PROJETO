<Window x:Class="RatAnalyzer.Desktop.Views.VmGuestCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RatAnalyzer.Desktop.Localization"
        Title="Conta na VM de análise"
        Icon="/Assets/app-icon.ico"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Border Margin="24"
            Padding="22"
            Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=CredentialsSection}"
                           Style="{StaticResource SectionLabelTextBlock}"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=CredentialsTitle}"
                           Style="{StaticResource TitleTextBlock}"
                           FontSize="20" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Margin="0,0,0,18"
                       Style="{StaticResource SubtitleTextBlock}"
                       Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=CredentialsSubtitle}"
                       TextWrapping="Wrap"
                       LineHeight="18" />

            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=CredentialsUser}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,0,8" />
                <TextBox x:Name="UserTextBox" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=CredentialsPassword}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,0,8" />
                <PasswordBox x:Name="PasswordBox" />
            </StackPanel>

            <CheckBox x:Name="RememberCheckBox"
                      Grid.Row="4"
                      Margin="0,0,0,20"
                      Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=CredentialsRemember}"
                      IsChecked="True" />

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=CommonCancel}"
                        MinWidth="100"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Style="{StaticResource ModernButtonStyle}"
                        Click="Cancel_Click" />
                <Button Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=CommonContinue}"
                        MinWidth="100"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Continue_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
