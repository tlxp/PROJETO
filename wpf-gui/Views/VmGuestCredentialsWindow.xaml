<Window x:Class="RatAnalyzer.Desktop.Views.VmGuestCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conta na VM de análise"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Utilizador e palavra-passe na VM"
                   Style="{StaticResource TitleTextBlock}" />

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,16"
                   Style="{StaticResource SubtitleTextBlock}"
                   TextWrapping="Wrap"
                   Text="Estas credenciais entram na VM via PowerShell Direct. Na primeira instalação são gravadas no autounattend.xml — devem ser as mesmas sempre. Utilizador predefinido: «analyst». Se a VM já foi instalada, use a mesma password (ex.: Analyst123! em dev); credenciais diferentes só funcionam após reinstalar a VM." />

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Utilizador na VM" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="UserTextBox"
                     Padding="8,6"
                     Background="{StaticResource SurfaceBrush}"
                     BorderBrush="{StaticResource BorderBrushBase}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     CaretBrush="{StaticResource TextPrimaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Palavra-passe na VM" FontWeight="SemiBold" Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordBox"
                         Padding="8,6"
                         Background="{StaticResource SurfaceBrush}"
                         BorderBrush="{StaticResource BorderBrushBase}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource TextPrimaryBrush}" />
        </StackPanel>

        <CheckBox x:Name="RememberCheckBox"
                  Grid.Row="4"
                  Margin="0,0,0,16"
                  Content="Lembrar nesta sessão da aplicação"
                  IsChecked="True"
                  Foreground="{StaticResource TextSecondaryBrush}" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    MinWidth="100"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    IsCancel="True"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="Cancel_Click" />
            <Button Content="Continuar"
                    MinWidth="100"
                    Padding="12,6"
                    IsDefault="True"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="Continue_Click" />
        </StackPanel>
    </Grid>
</Window>
