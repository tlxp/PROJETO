<UserControl x:Class="RatAnalyzer.Desktop.Views.LanguageSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RatAnalyzer.Desktop.Localization"
             xmlns:local="clr-namespace:RatAnalyzer.Desktop.Views">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="LanguageTabStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24,14" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Small}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LanguageTabSelectedStyle" TargetType="Button" BasedOn="{StaticResource LanguageTabStyle}">
            <Setter Property="Background" Value="#142E2B" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
        <StackPanel>
            <!-- Detalhe ligeiro: ícone + nome da app -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                <Border Width="32" Height="32"
                        CornerRadius="8"
                        BorderBrush="#1F4D47"
                        BorderThickness="1"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#142E2B" Offset="0" />
                            <GradientStop Color="#0D1F1D" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE756;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=AppTitle}"
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Opacity="0.9" />
            </StackPanel>

            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LanguageSection}"
                       Style="{StaticResource SectionLabelTextBlock}"
                       Margin="0,0,0,8" />
            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LanguageTitle}"
                       Style="{StaticResource TitleTextBlock}"
                       FontSize="24"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LanguageSubtitle}"
                       Style="{StaticResource SubtitleTextBlock}"
                       Margin="0,10,0,28"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <Border CornerRadius="{StaticResource Radius.Medium}"
                    Background="#0A0A0C"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    Padding="6"
                    Margin="0,0,0,24">
                <UniformGrid Columns="2">
                    <Button x:Name="PortugueseTab"
                            Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LanguagePortuguese}"
                            Margin="0,0,4,0"
                            Click="PortugueseTab_Click"
                            Style="{StaticResource LanguageTabSelectedStyle}" />
                    <Button x:Name="EnglishTab"
                            Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LanguageEnglish}"
                            Margin="4,0,0,0"
                            Click="EnglishTab_Click"
                            Style="{StaticResource LanguageTabStyle}" />
                </UniformGrid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="CancelButton"
                        Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LanguageCancel}"
                        MinWidth="120"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModernButtonStyle}"
                        Visibility="{Binding ShowCancel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                        Click="CancelButton_Click" />
                <Button x:Name="ContinueButton"
                        Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LanguageContinue}"
                        MinWidth="140"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="ContinueButton_Click" />
            </StackPanel>

            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LanguageFooter}"
                       Style="{StaticResource MutedTextBlock}"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,18,0,0"
                       Opacity="0.65" />
        </StackPanel>
    </Grid>
</UserControl>
