<Window x:Class="RatAnalyzer.Desktop.Views.StorageMaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RatAnalyzer.Desktop.Views"
        xmlns:loc="clr-namespace:RatAnalyzer.Desktop.Localization"
        Title="Manutenção de armazenamento"
        Icon="/Assets/app-icon.ico"
        Width="780"
        Height="540"
        MinWidth="640"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageSection}"
                       Style="{StaticResource SectionLabelTextBlock}"
                       Margin="0,0,0,6" />
            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageTitle}"
                       Style="{StaticResource TitleTextBlock}"
                       FontSize="22" />
            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageSubtitle}"
                       Style="{StaticResource SubtitleTextBlock}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="18">
                <StackPanel>
                    <!-- Estimativa -->
                    <Border Padding="16"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Background="#0A0A0C"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageEstimateTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                            <TextBlock Text="{Binding EstimateText}"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PathsText}"
                                       Margin="0,6,0,0"
                                       Style="{StaticResource MutedTextBlock}"
                                       TextWrapping="Wrap" />
                            <Button Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageRefreshEstimate}"
                                    Margin="0,12,0,0"
                                    Width="190"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Command="{Binding RefreshEstimateCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </Border>

                    <Separator />

                    <!-- Limpeza soft -->
                    <Border Padding="16"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Background="#0A0A0C"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageSoftTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageSoftDesc}"
                                       Style="{StaticResource MutedTextBlock}"
                                       Margin="0,6,0,12"
                                       TextWrapping="Wrap" />
                            <WrapPanel>
                                <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageKeepRecent}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                                <TextBox Width="70" Text="{Binding KeepMostRecent, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageKeepDays}" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="12" />
                                <TextBox Width="70" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <Button Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageCleanupNow}"
                                    Margin="0,12,0,0"
                                    Width="140"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Command="{Binding RunCleanupCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </Border>

                    <Separator />

                    <!-- Arquivo frio -->
                    <Border Padding="16"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Background="#0A0A0C"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageArchiveTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageArchiveDesc}"
                                       Style="{StaticResource MutedTextBlock}"
                                       Margin="0,6,0,12"
                                       TextWrapping="Wrap" />
                            <WrapPanel>
                                <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageArchiveDays}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                                <TextBox Width="70" Text="{Binding ArchiveDays, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <Button Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StorageArchiveNow}"
                                    Margin="0,12,0,0"
                                    Width="150"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Command="{Binding RunArchiveCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </Border>

                    <Separator />

                    <!-- Limpeza completa -->
                    <Border Padding="16"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Background="#140A0E"
                            BorderBrush="#3D1A24"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StoragePurgeTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StoragePurgeDesc}"
                                       Style="{StaticResource MutedTextBlock}"
                                       Margin="0,6,0,12"
                                       TextWrapping="Wrap" />
                            <Button Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=StoragePurgeNow}"
                                    Width="180"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding RunFullPurgeCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusText}"
                               Margin="0,16,0,0"
                               Style="{StaticResource MutedTextBlock}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=CommonClose}"
                    Width="120"
                    Style="{StaticResource ModernButtonStyle}"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
