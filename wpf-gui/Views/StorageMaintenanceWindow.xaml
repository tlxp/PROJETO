<Window x:Class="RatAnalyzer.Desktop.Views.StorageMaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RatAnalyzer.Desktop.Views"
        Title="Manutenção de armazenamento"
        Width="760"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Manutenção / Limpeza" Style="{StaticResource TitleTextBlock}" />
            <TextBlock Text="Estimativa e limpeza segura de dados temporários e artefactos antigos."
                       Style="{StaticResource SubtitleTextBlock}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushBase}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Medium}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="14">
                <StackPanel>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Espaço atual (estimativa)" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EstimateText}"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PathsText}"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                        <Button Content="Recalcular estimativa"
                                Margin="0,10,0,0"
                                Width="190"
                                Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding RefreshEstimateCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>

                    <Separator Margin="0,14,0,14" Background="{StaticResource BorderBrushBase}" />

                    <StackPanel>
                        <TextBlock Text="Limpeza segura (soft) do histórico de jobs" FontWeight="SemiBold" />
                        <TextBlock Text="Remove artefactos antigos em disco (sandbox_jobs) para jobs concluídos/falhados, mantendo a base de dados."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"/>

                        <WrapPanel>
                            <TextBlock Text="Reter últimos:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="70" Text="{Binding KeepMostRecent, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="  |  Reter por dias:" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <TextBox Width="70" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>

                        <Button Content="Limpar agora"
                                Margin="0,10,0,0"
                                Width="140"
                                Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding RunCleanupCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>

                    <Separator Margin="0,14,0,14" Background="{StaticResource BorderBrushBase}" />

                    <StackPanel>
                        <TextBlock Text="Arquivo frio (compressão)" FontWeight="SemiBold" />
                        <TextBlock Text="Zipa out/ em out.zip para jobs antigos e remove a pasta original (recuperação continua possível)."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"/>
                        <WrapPanel>
                            <TextBlock Text="Arquivar com mais de (dias):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="70" Text="{Binding ArchiveDays, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <Button Content="Arquivar agora"
                                Margin="0,10,0,0"
                                Width="150"
                                Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding RunArchiveCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>

                    <Separator Margin="0,14,0,14" Background="{StaticResource BorderBrushBase}" />

                    <StackPanel>
                        <TextBlock Text="Limpeza completa" FontWeight="SemiBold" />
                        <TextBlock Text="Apaga histórico local, amostras, relatórios, descompilados e caches temporários de análise em %LOCALAPPDATA%\RatAnalyzer (mantém a pasta Ghidra se existir — instalação usada no arranque). Esta ação é irreversível para os dados de análise."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"/>
                        <Button Content="Limpeza completa"
                                Margin="0,4,0,0"
                                Width="180"
                                Foreground="{StaticResource DangerBrush}"
                                BorderBrush="{StaticResource DangerBrush}"
                                Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding RunFullPurgeCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}"
                               Margin="0,14,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Fechar"
                    Width="120"
                    Style="{StaticResource ModernButtonStyle}"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>
