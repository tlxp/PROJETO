<UserControl x:Class="RatAnalyzer.Desktop.Views.MainDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RatAnalyzer.Desktop.Views">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="8,0,8,16">
            <TextBlock Text="Analisar executáveis suspeitos"
                       Style="{StaticResource TitleTextBlock}" />
            <TextBlock Text="Arraste um ficheiro .exe / .dll / .zip para a sandbox de análise."
                       Style="{StaticResource SubtitleTextBlock}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Drag & Drop Zone -->
        <Border Grid.Row="1"
                x:Name="FileDropBorder"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Large}"
                Margin="0,0,0,8"
                AllowDrop="True"
                Drop="FileDropArea_Drop">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="Effect" Value="{StaticResource Shadow.Medium}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Background" Value="#050816" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <!-- Initial State: Drag Instructions -->
                <StackPanel VerticalAlignment="Center"
                            Visibility="{Binding ShowOptions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}">
                    <Border Width="70"
                            Height="70"
                            CornerRadius="16"
                            Background="{StaticResource SurfaceAltBrush}"
                            HorizontalAlignment="Center">
                        <Viewbox>
                            <TextBlock Text=""
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Viewbox>
                    </Border>

                    <TextBlock Text="Arraste e largue um ficheiro para começar"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                    <TextBlock Text="Também pode largar arquivos com vários samples."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                    <Button x:Name="SelectFileButton"
                            Content="Selecionar ficheiro..."
                            Margin="0,16,0,0"
                            Padding="14,8"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="SelectFileButton_Click"
                            ToolTip="Use este botão se arrastar e largar não funcionar (ex.: ao executar como Administrador)." />
                </StackPanel>

                <!-- Post-Drop State: Analysis Options -->
                <StackPanel VerticalAlignment="Center"
                            Visibility="{Binding ShowOptions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Escolha o tipo de análise"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="19"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Executa a análise localmente na pipeline estática ou comportamental da sandbox."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="StaticAnalysisButton"
                                Content="Análise estática"
                                Width="190"
                                Height="46"
                                Margin="8"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="StaticAnalysis_Click"/>
                        <Button x:Name="DynamicAnalysisButton"
                                Content="Análise comportamental em VM"
                                Width="210"
                                Height="46"
                                Margin="8"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="DynamicAnalysis_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="FirstTimeVmCheckBox"
                              Content="Primeira entrada na VM (instalar software comum com winget e criar snapshot)"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              FontSize="11"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Center"
                              IsChecked="False"
                              ToolTip="Marque se for a primeira vez: instala Chrome, 7zip, VSCode, etc. na VM e cria o snapshot limpo antes de correr a amostra."/>
                    <StackPanel Orientation="Vertical"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Width="360">
                        <TextBlock x:Name="StaticAnalysisStatusText"
                                   Text="A preparar análise estática..."
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                        <ProgressBar x:Name="StaticAnalysisProgressBar"
                                     Width="260"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     IsIndeterminate="False"
                                     Visibility="Collapsed"
                                     Margin="0,4,0,0" />
                        <!-- Informação detalhada sobre o job atual (ID e URL de resultados) -->
                        <TextBlock x:Name="StaticAnalysisJobIdText"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="StaticAnalysisJobUrlText"
                                   Margin="0,2,0,0"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource AccentSoftBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button x:Name="OpenResultsButton"
                                Content="Abrir página de resultados"
                                Width="220"
                                Height="32"
                                Margin="0,8,0,0"
                                Visibility="Collapsed"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="OpenResultsButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

