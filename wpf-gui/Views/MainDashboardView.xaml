<UserControl x:Class="RatAnalyzer.Desktop.Views.MainDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RatAnalyzer.Desktop.Views"
             xmlns:loc="clr-namespace:RatAnalyzer.Desktop.Localization">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardSection}"
                           Style="{StaticResource SectionLabelTextBlock}"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardTitle}"
                           Style="{StaticResource TitleTextBlock}"
                           FontSize="22" />
                <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardSubtitle}"
                           Style="{StaticResource SubtitleTextBlock}"
                           Margin="0,6,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=ChangeLanguage}"
                    Padding="12,6"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="ChangeLanguageButton_Click" />
        </Grid>

        <Border Grid.Row="1"
                x:Name="FileDropBorder"
                CornerRadius="{StaticResource Radius.Large}"
                Margin="0,0,0,4"
                AllowDrop="True"
                Drop="FileDropArea_Drop">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid MinHeight="380">
                <Grid Visibility="{Binding ShowOptions, Converter={StaticResource InverseBoolToVis}}">
                    <Rectangle RadiusX="16" RadiusY="16"
                               Stroke="{StaticResource BorderBrushBase}"
                               StrokeThickness="1.5"
                               StrokeDashArray="6 4"
                               Margin="24"
                               Fill="Transparent"
                               Opacity="0.7" />

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                        <Border Width="80" Height="80"
                                CornerRadius="20"
                                HorizontalAlignment="Center"
                                BorderBrush="#1F4D47"
                                BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#142E2B" Offset="0" />
                                    <GradientStop Color="#0D1F1D" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE896;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="32"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardDropTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0" />
                        <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardDropHint}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />

                        <Button Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardSelectFile}"
                                Margin="0,22,0,0"
                                Padding="18,10"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SelectFileCommand}"
                                ToolTip="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardSelectFileTooltip}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Visibility="{Binding ShowOptions, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="28,24">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardChooseAnalysis}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardChooseHint}"
                                   Style="{StaticResource MutedTextBlock}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,24" />

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardStaticAnalysis}"
                                    Height="52"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Command="{Binding RunStaticAnalysisCommand}"
                                    IsEnabled="{Binding IsStaticAnalysisBusy, Converter={StaticResource InverseBool}}" />
                            <Button Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardVmAnalysis}"
                                    Height="52"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding RunDynamicAnalysisCommand}" />
                        </UniformGrid>

                        <Button Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardMaintenance}"
                                Margin="0,4,0,0"
                                Padding="14,8"
                                HorizontalAlignment="Center"
                                Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding OpenStorageMaintenanceCommand}"
                                ToolTip="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardMaintenanceTooltip}" />

                        <Border Margin="0,20,0,0"
                                Padding="18,14"
                                CornerRadius="{StaticResource Radius.Medium}"
                                Background="#0A0A0C"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardVmOptions}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,10" />
                                <CheckBox Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardVmFirstTime}"
                                          Margin="0,0,0,8"
                                          IsChecked="{Binding RunFirstTimeVmSetup}"
                                          ToolTip="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardVmFirstTimeTooltip}" />
                                <CheckBox Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardVmWaitExit}"
                                          IsChecked="{Binding VmWaitForSampleExit}"
                                          ToolTip="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardVmWaitExitTooltip}" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0"
                                            IsEnabled="{Binding VmWaitForSampleExit, Converter={StaticResource InverseBool}}">
                                    <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardVmTimeout}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <TextBox Text="{Binding VmSampleTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                             Width="80"
                                             ToolTip="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardVmTimeoutTooltip}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="18,14"
                                CornerRadius="{StaticResource Radius.Medium}"
                                Background="#0A0A0C"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding StaticStatusText}"
                                           Visibility="{Binding ShowStaticStatus, Converter={StaticResource BoolToVis}}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center" />
                                <ProgressBar Width="280"
                                             Margin="0,10,0,0"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding StaticProgressValue, Mode=OneWay}"
                                             IsIndeterminate="{Binding StaticProgressIndeterminate, Mode=OneWay}"
                                             Visibility="{Binding ShowStaticProgress, Converter={StaticResource BoolToVis}}"
                                             HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding StaticJobIdText}"
                                           Margin="0,10,0,0"
                                           Visibility="{Binding ShowStaticJobDetails, Converter={StaticResource BoolToVis}}"
                                           Style="{StaticResource MutedTextBlock}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StaticJobUrlText}"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding ShowStaticJobDetails, Converter={StaticResource BoolToVis}}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Button Content="{Binding Source={x:Static loc:UiStrings.Instance}, Path=DashboardOpenResults}"
                                        Width="240"
                                        Height="36"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding ShowOpenResults, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding OpenResultsCommand}"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
