<UserControl x:Class="RatAnalyzer.Desktop.Views.MainDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RatAnalyzer.Desktop.Views">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="8,0,8,16">
            <TextBlock Text="Analisar executáveis suspeitos"
                       Style="{StaticResource TitleTextBlock}" />
            <TextBlock Text="Arraste um ficheiro .exe / .dll / .zip para a sandbox de análise."
                       Style="{StaticResource SubtitleTextBlock}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                x:Name="FileDropBorder"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Large}"
                Margin="0,0,0,8"
                AllowDrop="True"
                Drop="FileDropArea_Drop">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="Effect" Value="{StaticResource Shadow.Medium}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Background" Value="#050816" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <StackPanel VerticalAlignment="Center"
                            Visibility="{Binding ShowOptions, Converter={StaticResource InverseBoolToVis}}">
                    <Border Width="70"
                            Height="70"
                            CornerRadius="16"
                            Background="{StaticResource SurfaceAltBrush}"
                            HorizontalAlignment="Center">
                        <Viewbox>
                            <TextBlock Text=""
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Viewbox>
                    </Border>

                    <TextBlock Text="Arraste e largue um ficheiro para começar"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                    <TextBlock Text="Também pode largar arquivos com vários samples."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                    <Button Content="Selecionar ficheiro..."
                            Margin="0,16,0,0"
                            Padding="14,8"
                            Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding SelectFileCommand}"
                            ToolTip="Use este botão se arrastar e largar não funcionar (ex.: ao executar como Administrador)." />
                </StackPanel>

                <StackPanel VerticalAlignment="Center"
                            Visibility="{Binding ShowOptions, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Escolha o tipo de análise"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="19"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Executa a análise localmente na pipeline estática ou comportamental da sandbox."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Análise estática"
                                Width="190"
                                Height="46"
                                Margin="8"
                                Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding RunStaticAnalysisCommand}"
                                IsEnabled="{Binding IsStaticAnalysisBusy, Converter={StaticResource InverseBool}}" />
                        <Button Content="Análise comportamental em VM"
                                Width="210"
                                Height="46"
                                Margin="8"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding RunDynamicAnalysisCommand}" />
                    </StackPanel>
                    <Button Content="Manutenção / Limpeza..."
                            Margin="0,10,0,0"
                            Padding="12,6"
                            Width="200"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding OpenStorageMaintenanceCommand}"
                            ToolTip="Limpeza segura de jobs antigos e estimativa de espaço." />
                    <CheckBox Content="Primeira entrada na VM (instalar software comum com winget e criar snapshot)"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              FontSize="11"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Center"
                              IsChecked="{Binding RunFirstTimeVmSetup}"
                              ToolTip="Marque se for a primeira vez: instala Chrome, 7zip, VSCode, etc. na VM e cria o snapshot limpo antes de correr a amostra." />
                    <CheckBox Content="Aguardar fim natural da amostra (sem matar por timeout)"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              FontSize="11"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Center"
                              IsChecked="{Binding VmWaitForSampleExit}"
                              ToolTip="Se activo, a sandbox espera a amostra terminar sozinha (limite de segurança 2h). Desactive para limitar o tempo activo abaixo." />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0"
                                IsEnabled="{Binding VmWaitForSampleExit, Converter={StaticResource InverseBool}}">
                        <TextBlock Text="Tempo activo máximo (s):"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Text="{Binding VmSampleTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Width="72"
                                 Padding="6,4"
                                 FontSize="11"
                                 ToolTip="Usado quando a opção acima está desactivada. A amostra é terminada após este tempo se ainda estiver a correr." />
                    </StackPanel>
                    <StackPanel Orientation="Vertical"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Width="360">
                        <TextBlock Text="{Binding StaticStatusText}"
                                   Visibility="{Binding ShowStaticStatus, Converter={StaticResource BoolToVis}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                        <ProgressBar Width="260"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding StaticProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding StaticProgressIndeterminate, Mode=OneWay}"
                                     Visibility="{Binding ShowStaticProgress, Converter={StaticResource BoolToVis}}"
                                     Margin="0,4,0,0" />
                        <TextBlock Text="{Binding StaticJobIdText}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding ShowStaticJobDetails, Converter={StaticResource BoolToVis}}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StaticJobUrlText}"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding ShowStaticJobDetails, Converter={StaticResource BoolToVis}}"
                                   Foreground="{StaticResource AccentSoftBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Content="Abrir página de resultados"
                                Width="220"
                                Height="32"
                                Margin="0,8,0,0"
                                Visibility="{Binding ShowOpenResults, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding OpenResultsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
