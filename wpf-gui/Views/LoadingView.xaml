<UserControl x:Class="RatAnalyzer.Desktop.Views.LoadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RatAnalyzer.Desktop.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,20">
            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LoadingSection}"
                       Style="{StaticResource SectionLabelTextBlock}"
                       Margin="0,0,0,6" />
            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LoadingTitle}"
                       Style="{StaticResource TitleTextBlock}"
                       FontSize="22" />
            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LoadingSubtitle}"
                       Style="{StaticResource SubtitleTextBlock}"
                       Margin="0,6,0,0"
                       MaxWidth="640"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="1.4*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,14,0"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Ellipse Width="200" Height="200"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="0,-20,0,0"
                             Opacity="0.12">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#2DD4BF" Offset="0" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="28,32">
                        <Grid Width="120" Height="120" Margin="0,0,0,24">
                            <Ellipse Width="120" Height="120"
                                     Stroke="#1F4D47"
                                     StrokeThickness="1"
                                     Opacity="0.6" />
                            <Ellipse Width="96" Height="96"
                                     Stroke="{StaticResource AccentBrush}"
                                     StrokeThickness="2"
                                     Opacity="0.25"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360"
                                                                 Duration="0:0:3"
                                                                 RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Width="72" Height="72"
                                     Stroke="{StaticResource AccentBrush}"
                                     StrokeThickness="5"
                                     StrokeDashArray="8 4"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="360" To="0"
                                                                 Duration="0:0:1.2"
                                                                 RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Width="14" Height="14"
                                     Fill="{StaticResource AccentBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LoadingSpinner}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LoadingLocalHint}"
                                   Style="{StaticResource MutedTextBlock}"
                                   Margin="0,8,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="240" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="3" Opacity="1">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.2" Duration="0:0:0.8"
                                                                 AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="3" Opacity="0.6">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.25">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.2" Duration="0:0:0.8"
                                                                 AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="3" Opacity="0.3">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.5">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.2" Duration="0:0:0.8"
                                                                 AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="14,0,0,0"
                    Style="{StaticResource CardBorderStyle}">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LoadingLogsTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LoadingLogsPorts}"
                                       Style="{StaticResource MutedTextBlock}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="8,4"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Background="#142E2B"
                                BorderBrush="#1F4D47"
                                BorderThickness="1"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource SuccessBrush}"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.3" Duration="0:0:1"
                                                                     AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="{Binding Source={x:Static loc:UiStrings.Instance}, Path=LoadingLive}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TerminalBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Background="#060608"
                            BorderBrush="#1A1A22"
                            BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="12,10">
                            <ItemsControl ItemsSource="{Binding SystemLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='› {0}'}"
                                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
