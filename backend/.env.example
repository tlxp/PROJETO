# Copie para backend/.env (ou exporte no ambiente) — nunca versione valores reais.
# Gere valores seguros: scripts/generate-production-secrets.ps1

# --- Modo produção (obrigatório em deploy) ---
# RATANALYZER_ENV=production
# RATANALYZER_API_TOKEN=<token-aleatório-32+ bytes>
# VM_AGENT_TOKEN=<mesmo valor configurado no vm-agent da sandbox>

# --- Modo estrito sem marcar produção ---
# RATANALYZER_REQUIRE_API_TOKEN=1
# RATANALYZER_API_TOKEN=<token>

# --- Opcional ---
# RATANALYZER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# RATANALYZER_MAX_UPLOAD_MB=100
# RATANALYZER_MAX_WORKERS=2
# RATANALYZER_RATE_LIMIT_UPLOADS_PER_MIN=60
# RATANALYZER_DATA_DIR=
