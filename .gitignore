# Saídas do RAT Analyzer (legado na raiz — canónico: DATA_DIR/decompiled, ver backend/config.py)
reports/
/decompiled/

# Resíduos locais na raiz (não versionar)
/err.txt
/out.txt
# Autounattend canónico: scripts/hyperv-sandbox/autounattend-malware-behavior-detection-user-gen1.xml
/autounattend-malware-behavior-detection-user-gen1.xml

# YARA rules compiladas
*.yarac

# WPF GUI – binários e artefatos de build
wpf-gui/bin/
wpf-gui/obj/
# WPF GUI – pastas temporárias de verificação de build
wpf-gui/_*/

# Sandbox – instaladores de runtime grandes (obter via EnsureRuntimes/Downloads.ps1 ou 06-Prepare-GuestDependencies.ps1)
scripts/hyperv-sandbox/tools/*.exe

# .NET (genérico) – ajuda a evitar commits de build em qualquer projeto
**/bin/
**/obj/
**/publish/
**/*_wpftmp.csproj

# Visual Studio / IDE files
.vs/
*.user
*.suo
*.csproj.user
*.userosscache
*.sln.docstates

# Dados de runtime (jobs, DB, reports, decompiled) — ver backend/config.py (DATA_DIR)
sandbox_jobs/
data/

# Frontend – build e dependências (redundante com frontend/.gitignore; reforço na raiz)
frontend/dist/
frontend/node_modules/
.vscode/
.idea/
*.swp
*.swo

# Sistema
.DS_Store
Thumbs.db

# Scripts de terceiros (não versionados — transferir localmente se necessário)
scripts/hyperv-sandbox/tools/winutil.ps1

# Segredos locais (gerar com scripts/generate-production-secrets.ps1)
secrets/
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# MalwareBazaar samples (manual download — never commit)
backend/evaluation/malwarebazaar_samples/**
!backend/evaluation/malwarebazaar_samples/README.md

# Benign sample builds (regenerate with benign-samples/build.ps1)
benign-samples/dist/

# Diagramas — fonte única docs/diagrams/; não versionar .puml derivados do relatório
relatório/imagens/fig-4-*.puml
relatório/imagens/plantuml.jar

# Template LaTeX UBI (referência local; não versionar)
relatório/Formato-LaTeX-Relatorio-2020/
