# --- EditorConfig: convenções de formatação do monorepo ---
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,json,css,html,yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.{cs,xaml,csproj,sln}]
end_of_line = crlf

[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
