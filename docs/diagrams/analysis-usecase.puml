' --- Diagram: RAT Analyzer use cases ---
@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Analyst" as A

rectangle "RAT Analyzer" {
  usecase "Upload sample" as UC1
  usecase "Static analysis" as UC2
  usecase "Dynamic analysis" as UC3
  usecase "View report" as UC4
  usecase "View score and indicators" as UC5
  usecase "View pseudo-C / IL" as UC6
  usecase "Explain code (AI)" as UC7
}

A --> UC1
A --> UC2
A --> UC3
A --> UC4
' *Static analysis includes score and decompilation; AI extends pseudo-C*
UC2 ..> UC5 : <<include>>
UC2 ..> UC6 : <<include>>
UC6 ..> UC7 : <<extend>>

@enduml
