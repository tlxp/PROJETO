@startuml
title Analise Estatica - Sequencia detalhada

autonumber
actor "Utilizador" as U
participant "Frontend React" as FE
participant "Backend API" as API
participant "RAT Analyzer" as RAT

U -> FE: Carregar ficheiro + escolher estatica
FE -> API: POST /api/analyze_stream (multipart file)
API -> RAT: analyze(file, output_dir)
RAT --> API: resultados + artefactos

loop durante a analise
API --> FE: {"type":"log","message":"..."}
end

API --> FE: {"type":"result", report,cCode,ilCode,fileName,\nriskScore,riskLevel,flaggedIndicators,flaggedFunctions}
FE --> U: Mostrar pontuacao, codigo e relatorio

alt erro
API --> FE: {"type":"error","message":"..."}
FE --> U: Mostrar erro da analise
end

@enduml
