' --- Diagram: dynamic analysis pipeline ---
@startuml
title Dynamic analysis pipeline — RAT Analyzer

start
:User submits sample\n(mode dynamic or both);
:Create job in API (SQLite);
:VM orchestrator selects driver;

if (Driver configured?) then (hyperv / proxmox)
  :Restore CleanState snapshot;
  :Start isolated VM (no Internet);
  ' *Path A: HTTP vm-agent; Path B: PowerShell/WPF scripts*
  if (Path A — vm-agent HTTP?) then (yes)
    :Upload + run + report via vm-agent;
    :Execute sample with timeout;
    :Collect behaviour\n(processes, files, registry, network);
  else (Path B — PowerShell / WPF)
    :04-Run-Sample.ps1\n(restore, copy sample/scripts);
    :Run Run-MalwareAnalysis in VM;
    :Wait for guest_analysis_done.txt;
    :Copy report guest→host\n(PsDirect / Copy-VMFile);
    :Verify SHA256 after copy;
  endif
  :Restore snapshot and stop VM;
else (stub)
  ' *Stub driver: synthetic result without real execution*
  :Generate synthetic result (no real execution);
endif

:Save dynamicResult in job;
:Frontend polls job state;
:Present behavioural report;
stop

@enduml
