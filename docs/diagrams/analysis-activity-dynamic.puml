' --- Diagram: dynamic analysis pipeline ---
@startuml
title Dynamic analysis pipeline — RAT Analyzer

start
:User submits sample\n(mode dynamic or both on web,\nor WPF for Path B);

if (Entry point?) then (Web — Path A)
  :Create job via POST /api/analysis;
  :VM orchestrator selects driver;
  if (Driver configured?) then (hyperv / proxmox)
    :Restore CleanState snapshot;
    :Start isolated VM (no Internet);
    :Upload + run + report via vm-agent;
    :Collect behaviour (basic telemetry);
    :Restore snapshot and stop VM;
  else (stub)
    :Generate synthetic result (no real execution);
  endif
  :Save dynamicResult in job;
else (WPF — Path B)
  :04-Run-Sample.ps1 (restore, copy, run);
  :Run Run-MalwareAnalysis in VM;
  :Copy report guest→host (PsDirect);
  :Verify SHA256 after copy;
  :POST /api/analysis/upload_dynamic;
endif

:Frontend polls job state;
:Present behavioural report;
stop

@enduml
