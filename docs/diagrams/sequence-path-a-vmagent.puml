' --- Diagram: Path A sequence (vm-agent HTTP) ---
@startuml
title Sequence — Path A (vm-agent HTTP)
autonumber
skinparam responseMessageBelowArrow true

actor "User" as U
participant "Frontend" as FE
participant "API FastAPI" as API
participant "VM Orchestrator" as VMO
participant "hyperv driver" as DRV
participant "Hyper-V host" as HV
participant "vm-agent" as AGENT
database "sandbox_jobs" as DB

U -> FE : submit sample (dynamic/both)
FE -> API : POST /api/analysis\nX-API-Token
API -> DB : create_job (queued)
API --> FE : jobId

API -> VMO : dynamic pipeline
' *Restore snapshot and start isolated VM*
VMO -> DRV : restore + start VM
DRV -> HV : Restore-VMSnapshot CleanState
DRV -> HV : Start-VM
DRV -> AGENT : GET /api/health\nX-Agent-Token

' *Upload → run → report cycle via HTTP*
DRV -> AGENT : POST /api/upload
AGENT --> DRV : uploaded

DRV -> AGENT : POST /api/run\n(timeout)
AGENT -> AGENT : execute sample\nisolated in guest
AGENT --> DRV : behaviour JSON

DRV -> HV : Stop-VM + restore snapshot
VMO -> DB : dynamicResult (completed)

loop polling
  FE -> API : GET /api/analysis/{jobId}
  API -> DB : read state
  API --> FE : behavioural report
end

@enduml
