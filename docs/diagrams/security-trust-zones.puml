' --- Diagram: trust zones (host, sandbox, guest) ---
@startuml
title Trust zones — RAT Analyzer
skinparam shadowing false
skinparam packageStyle rectangle

cloud "Internet" as NET #FFCDD2

package "Host zone (operator)" #E8F5E9 {
  [Frontend :8080] as WEB
  [Backend API :8000] as API
  [WPF Desktop] as WPF
  [Hyper-V Scripts\nhyperv-sandbox] as PS
}

package "Internal sandbox network\n(Hyper-V Internal switch)" #E3F2FD {
  [vm-agent :5000] as VMA
}

package "Guest zone (untrusted)" #FFE0B2 {
  [Malware sample] as SAMPLE
  [Run-MalwareAnalysis.ps1] as VMPS
}

' *Token authentication between layers*
WEB --> API : X-API-Token
WPF --> API : X-API-Token
WPF --> PS : local orchestration
API --> VMA : hyperv driver\nX-Agent-Token
PS --> VMPS : PsDirect +\nSHA256
VMA --> SAMPLE : upload / run
VMPS --> SAMPLE : isolated execution

' *Guest has no Internet access*
NET ..> SAMPLE : blocked
NET ..> VMPS : blocked

note right of API
  Tokens and credentials
  remain on the host
end note

note bottom of SAMPLE
  No Internet;
  CleanState snapshot
  before each run
end note

@enduml
