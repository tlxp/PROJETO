' --- Diagrama: zonas de confiança (host, sandbox, guest) ---
@startuml
title Zonas de confiança — RAT Analyzer
skinparam shadowing false
skinparam packageStyle rectangle

cloud "Internet" as NET #FFCDD2

package "Zona host (operador)" #E8F5E9 {
  [Frontend :8080] as WEB
  [Backend API :8000] as API
  [WPF Desktop] as WPF
  [Scripts Hyper-V\nhyperv-sandbox] as PS
}

package "Rede interna sandbox\n(switch Internal Hyper-V)" #E3F2FD {
  [vm-agent :5000] as VMA
}

package "Zona guest (não confiável)" #FFE0B2 {
  [Amostra malware] as SAMPLE
  [Run-MalwareAnalysis.ps1] as VMPS
}

' *Autenticação por token entre camadas*
WEB --> API : X-API-Token
WPF --> API : X-API-Token
WPF --> PS : orquestração local
API --> VMA : driver hyperv\nX-Agent-Token
PS --> VMPS : PsDirect +\nSHA256
VMA --> SAMPLE : upload / run
VMPS --> SAMPLE : execução isolada

' *Guest sem acesso à Internet*
NET ..> SAMPLE : bloqueado
NET ..> VMPS : bloqueado

note right of API
  Tokens e credenciais
  permanecem no host
end note

note bottom of SAMPLE
  Sem Internet;
  snapshot CleanState
  antes de cada run
end note

@enduml
