' --- Diagram: authentication map and tokens ---
@startuml
title Authentication map — tokens and credentials
skinparam shadowing false
skinparam componentStyle rectangle

actor "Analyst" as U

package "Client" #E8F5E9 {
  [Frontend React\nVITE_API_TOKEN] as FE
  [WPF Desktop] as WPF
}

package "API host" #E3F2FD {
  [Backend FastAPI\nRATANALYZER_API_TOKEN] as API
  [upload_security.py] as UP
}

package "Sandbox" #FFE0B2 {
  [vm-agent\nVM_AGENT_TOKEN] as AGENT
  [Hyper-V Scripts\nPROJETOVM_Guest*] as PS
}

database "secrets/\nbackend.env" as SEC

U --> FE
U --> WPF

' *API token shared between clients and backend*
FE --> API : X-API-Token
WPF --> API : X-API-Token
WPF --> PS : guest credentials
API --> UP : validate uploads
API --> AGENT : X-Agent-Token\n(hyperv driver)

' *Single secrets source in secrets/backend.env*
SEC ..> API : RATANALYZER_API_TOKEN
SEC ..> FE : build-time token
SEC ..> AGENT : VM_AGENT_TOKEN
SEC ..> PS : PROJETOVM_GuestPassword

note right of API
  **Fail-closed** in production:
  RATANALYZER_ENV=production
  requires valid token
end note

note bottom of AGENT
  Constant-time comparison
  (TokenComparer.cs)
end note

note bottom of PS
  PowerShell Direct —
  no HTTP token;
  password required
  (except dev flag)
end note

' *Stub driver does not execute samples or require auth*
rectangle "Stub driver" as STUB #F5F5F5
API ..> STUB : no auth\n(does not execute samples)

@enduml
