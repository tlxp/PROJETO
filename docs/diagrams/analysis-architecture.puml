' --- Diagram: layered conceptual architecture ---
@startuml
title Conceptual architecture — RAT Analyzer
skinparam componentStyle rectangle
skinparam shadowing false

package "Presentation Layer" #E8F5E9 {
  [Frontend React\nDrop & Analyze] as FE
  [Desktop WPF\nRat Analyzer] as WPF
  [CLI Python\nrat_analyzer.py] as CLI
}

package "API / Orchestration Layer" #E3F2FD {
  [FastAPI\nbackend/api.py] as API
  [Job Store\nSQLite + sandbox_jobs] as DB
  [VM Orchestrator] as VMO
}

package "Analysis Layer" #FFF9C4 {
  [Static Analyzer] as SA
  [YARA Scanner] as YARA
  [Decompilers\nILSpy / Ghidra] as DEC
  [Risk Scorer] as RS
}

package "Sandbox Infrastructure" #FFE0B2 {
  [Hyper-V VM\nMalwareSandbox] as HV
  [vm-agent\nMinimal API] as AGENT
  [PowerShell Scripts\nhyperv-sandbox] as PS1
}

' *HTTP clients and local orchestration*
FE --> API : HTTP REST
WPF --> API : HTTP REST
WPF --> PS1 : local orchestration
CLI --> SA : direct library
API --> SA
API --> DB
API --> VMO
SA --> YARA
SA --> DEC
SA --> RS
' *Two independent sandbox paths*
VMO --> AGENT : Path A
VMO --> HV
PS1 --> HV : Path B
AGENT --> HV

@enduml
