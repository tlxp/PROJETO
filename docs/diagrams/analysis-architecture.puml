@startuml
title Arquitetura conceptual — RAT Analyzer
skinparam componentStyle rectangle
skinparam shadowing false

package "Camada de Apresentação" #E8F5E9 {
  [Frontend React\nDrop & Analyze] as FE
  [Desktop WPF\nRatAnalyzer.Desktop] as WPF
  [CLI Python\nrat_analyzer.py] as CLI
}

package "Camada API / Orquestração" #E3F2FD {
  [FastAPI\nbackend/api.py] as API
  [Job Store\nSQLite + sandbox_jobs] as DB
  [VM Orchestrator] as VMO
}

package "Camada de Análise" #FFF9C4 {
  [Static Analyzer] as SA
  [YARA Scanner] as YARA
  [Decompilers\nILSpy / Ghidra] as DEC
  [Risk Scorer] as RS
}

package "Infraestrutura Sandbox" #FFE0B2 {
  [Hyper-V VM\nMalwareSandbox] as HV
  [vm-agent\nMinimal API] as AGENT
  [Scripts PowerShell\nhyperv-sandbox] as PS1
}

FE --> API : HTTP REST
WPF --> API : HTTP REST
WPF --> PS1 : orquestração local
CLI --> SA : biblioteca direta
API --> SA
API --> DB
API --> VMO
SA --> YARA
SA --> DEC
SA --> RS
VMO --> AGENT : Caminho A
VMO --> HV
PS1 --> HV : Caminho B
AGENT --> HV

@enduml
