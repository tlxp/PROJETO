@startuml
title Pipeline de análise estática — RAT Analyzer

start
:Upload ficheiro (.exe / .dll / .cs);
:Validar tipo e tamanho;

if (Ficheiro válido?) then (sim)
  :Extrair metadados PE;
  if (Assembly .NET?) then (sim)
    :Descompilar com ILSpy (C# / IL);
  else (não)
    :Descompilar com Ghidra (pseudo-C);
  endif
  :Análise estática\n(imports, strings C2, evasão, entropia);
  :Deobfuscação (Base64, XOR);
  :Scan YARA (yara_rules/);
  :Calcular score de risco;
  :Gerar relatório (JSON + texto);
  :Apresentar resultados no frontend;
  stop
else (não)
  :Devolver erro de validação;
  stop
endif

@enduml
