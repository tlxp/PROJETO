@startuml
title Analise Estatica - Diagrama de Atividade

start
:Utilizador carrega ficheiro;
:Frontend valida tipo de ficheiro;

if (Ficheiro valido?) then (sim)
  :Submeter para API;
  :API inicia pipeline estatica;
  :Extrair indicadores (imports, strings, evasao, YARA);
  :Gerar codigo e relatorio;
  :Calcular risco (score e nivel);
  :Devolver resultado ao frontend;
  :Frontend apresenta relatorio e funcoes suspeitas;
  stop
else (nao)
  :Frontend apresenta erro de validacao;
  stop
endif

@enduml
