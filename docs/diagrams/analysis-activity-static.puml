' --- Diagram: static analysis pipeline ---
@startuml
title Static analysis pipeline — RAT Analyzer

start
:Upload file (.exe / .dll / .cs);
:Validate type and size;

if (Valid file?) then (yes)
  :Extract PE metadata;
  ' *Decompiler chosen by assembly type*
  if (.NET assembly?) then (yes)
    :Decompile with ILSpy (C# / IL);
  else (no)
    :Decompile with Ghidra (pseudo-C);
  endif
  :Static analysis\n(imports, C2 strings, evasion, entropy);
  :Deobfuscation (Base64, XOR);
  :YARA scan (yara_rules/);
  :Calculate risk score;
  :Generate report (JSON + text);
  :Present results in frontend;
  stop
else (no)
  :Return validation error;
  stop
endif

@enduml
