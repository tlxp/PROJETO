' --- Diagrama: sequência integrada (estática + dinâmica + WPF) ---
@startuml
title Sequência integrada — RAT Analyzer (resumida)

autonumber
skinparam responseMessageBelowArrow true

actor "Utilizador" as U
participant "Frontend React" as FE
participant "WPF Desktop" as WPF
participant "API FastAPI" as API
participant "Jobs" as JOBS
participant "RAT Analyzer" as RAT
participant "VM Orchestrator" as VMO
participant "Driver VM" as DRV
participant "vm-agent" as AGENT
database "SQLite +\nsandbox_jobs" as DB

group Análise estática (streaming)
  U -> FE : Carregar ficheiro
  FE -> API : POST /api/analyze_stream
  API -> RAT : Pipeline estática
  RAT --> API : Resultado + logs NDJSON
  API --> FE : Progresso e relatório final
end

group Job dinâmico ou combinado
  U -> FE : Carregar + modo dynamic/both
  FE -> API : POST /api/analysis
  API -> JOBS : create_job
  JOBS -> DB : estado queued/running
  JOBS -> VMO : pipeline dinâmica
  ' *Driver real ou stub conforme configuração*
  alt hyperv / proxmox
    VMO -> DRV : driver real
    DRV -> AGENT : upload, run, report
    AGENT --> DRV : comportamento
  else stub
    DRV --> VMO : resultado sintético
  end
  JOBS -> DB : dynamicResult
  loop polling
    FE -> API : GET /api/analysis/{jobId}
    API -> DB : ler estado
    API --> FE : resultados
  end
end

group WPF → browser
  U -> WPF : Drag-and-drop + análise
  WPF -> API : análise + publicar job
  API -> DB : guardar jobId
  WPF -> FE : abrir /resultados?jobId=...
end

@enduml
