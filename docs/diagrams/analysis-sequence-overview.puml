@startuml
title RAT Analyzer - Sequencia integrada (resumida)

autonumber
skinparam responseMessageBelowArrow true

actor "Utilizador" as U
participant "Frontend React" as FE
participant "WPF Desktop" as WPF
participant "API Backend (FastAPI)" as API
participant "Jobs de Analise" as JOBS
participant "RAT Analyzer" as RAT
participant "Orquestrador de VM" as VMO
participant "Driver de VM\n(stub|hyperv|proxmox)" as DRV
participant "Agente de VM" as AGENT
database "Armazenamento de Jobs\n(SQLite + sandbox_jobs)" as DB

group Web estatica por streaming
U -> FE: Carregar ficheiro + modo estatica
FE -> API: Submeter analise estatica
API -> RAT: Executar analise estatica
RAT --> API: Resultado estatico
API --> FE: Progresso + resultado final
end

group Pipeline de jobs (estatica|dinamica|ambas)
U -> FE: Carregar ficheiro + modo dinamica/ambas/estatica
FE -> API: Criar job de analise
API -> JOBS: Registar e arrancar job
JOBS -> DB: Guardar estado do job
API --> FE: Devolver jobId

loop consulta periodica (polling)
FE -> API: GET /api/analysis/{jobId}
API -> DB: Ler estado e resultados
API --> FE: Estado + resultados disponiveis
end
end

group Execucao interna
alt estatica
JOBS -> RAT: Executar pipeline estatica
RAT --> JOBS: staticResult
else dinamica
JOBS -> VMO: Executar pipeline dinamica
VMO -> DRV: Correr driver configurado
alt hyperv/proxmox
DRV -> AGENT: Upload, execucao e relatorio
AGENT --> DRV: Comportamento observado
else stub
DRV --> VMO: comportamento sintetico
end
VMO --> JOBS: dynamicResult
end
JOBS -> DB: Guardar resultados e fechar job
end

group WPF publicar resultado estatico
U -> WPF: Arrastar e largar + Analise Estatica
WPF -> API: Executar analise estatica
API -> RAT: Correr pipeline estatica
RAT --> API: Resultado estatico
API --> WPF: resposta estatica
WPF -> API: Publicar resultado estatico
API -> DB: Guardar job concluido
API --> WPF: {jobId}
WPF -> FE: abrir /resultados?jobId=...
end

@enduml
