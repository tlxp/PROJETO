' --- Diagram: integrated sequence (static + dynamic + WPF) ---
@startuml
title Integrated sequence — RAT Analyzer (summary)

autonumber
skinparam responseMessageBelowArrow true

actor "User" as U
participant "Frontend React" as FE
participant "WPF Desktop" as WPF
participant "API FastAPI" as API
participant "Jobs" as JOBS
participant "RAT Analyzer" as RAT
participant "VM Orchestrator" as VMO
participant "VM Driver" as DRV
participant "vm-agent" as AGENT
database "SQLite +\nsandbox_jobs" as DB

group Static analysis (streaming)
  U -> FE : Load file + static mode
  FE -> API : POST /api/analyze_stream
  API -> RAT : Static pipeline
  RAT --> API : Result + NDJSON logs
  API --> FE : Progress and final report
  FE -> API : POST /api/analysis/upload_static
  API -> DB : jobId + staticResult
end

group Dynamic or combined job (Path A — web)
  U -> FE : Load file + dynamic/both mode
  FE -> API : POST /api/analysis
  API -> JOBS : create_job
  JOBS -> DB : state queued/running
  JOBS -> VMO : dynamic pipeline
  alt hyperv / proxmox
    VMO -> DRV : real driver
    DRV -> AGENT : upload, run, report
    AGENT --> DRV : behaviour
  else stub
    DRV --> VMO : synthetic result
  end
  JOBS -> DB : dynamicResult
  loop polling
    FE -> API : GET /api/analysis/jobId
    API -> DB : read state
    API --> FE : results
  end
end

group WPF Path B
  U -> WPF : Drag-and-drop + VM analysis
  WPF -> API : POST /api/analysis/upload_dynamic
  API -> DB : dynamicResult
  WPF -> FE : open /analysis/jobId
end

@enduml
