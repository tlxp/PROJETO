' --- Diagram: Path B sequence (PowerShell / PsDirect) ---
@startuml
title Sequence — Path B (PowerShell / PsDirect + SHA256)
autonumber
skinparam responseMessageBelowArrow true

actor "User" as U
participant "WPF Desktop" as WPF
participant "04-Run-Sample.ps1" as PS
participant "Hyper-V host" as HV
participant "Guest VM" as GUEST
participant "Run-MalwareAnalysis.ps1" as ANALYSIS

U -> WPF : drag-and-drop +\ndynamic analysis
WPF -> PS : invoke pipeline\n(guest credentials)
PS -> HV : Restore-VMSnapshot CleanState
PS -> HV : Start-VM
PS -> GUEST : copy sample +\nscripts (PsDirect)

PS -> ANALYSIS : Invoke-Command\nRun-MalwareAnalysis.ps1
ANALYSIS -> ANALYSIS : monitor\nfiles · registry · network
' *Completion file with SHA256 hash*
ANALYSIS -> GUEST : write C:\analysis.txt\n+ guest_analysis_done.txt\n(SHA256)

loop PhaseE-WaitReport
  PS -> GUEST : poll guest_analysis_done.txt
end

PS -> GUEST : Copy-SandboxVMFileFromGuest\n(PsDirect or Copy-VMFile)
GUEST --> PS : analysis_<RunId>.txt

' *Integrity verification before accepting report*
PS -> PS : Assert-SandboxCopiedReportHash\n(compare SHA256)
alt invalid hash
  PS -> PS : delete file on host
  PS --> WPF : integrity error
else valid hash
  PS -> HV : Stop-VM + restore snapshot
  PS --> WPF : report + run JSON
  WPF -> WPF : publish job to API\n(optional: open browser)
end

@enduml
